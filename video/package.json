{
  "name": "forja-abisal-video",
  "private": true,
  "version": "1.0.0",
  "description": "Vídeo de presentación de Forja Abisal: clips grabados por el juego, narración y montaje con Remotion.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
